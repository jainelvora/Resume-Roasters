# Gemini API Key from Google AI Studio (https://aistudio.google.com/)
# If left empty, the app runs the built-in deterministic demo battle!
GEMINI_API_KEY=

# Model to use (defaults to gemini-3-flash-preview)
GEMINI_MODEL=gemini-3-flash-preview

# Optional: lower the model's thinking effort to cut latency (e.g. low).
# Leave empty to use the model default.
GEMINI_THINKING_LEVEL=

# Backend server port
PORT=3001
